<?xml version="1.0" encoding="utf-8"?>
<!--
    CardView para cada ítem de gatito en la lista.
    - Esquinas muy redondeadas (24dp)
    - Borde pastel rosa
    - Imagen circular (ShapeableImageView)
    - Nombre del gatito
    - Flecha sutil como indicador de navegación
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="7dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="24dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/michi_surface"
    app:strokeColor="@color/michi_pink_light"
    app:strokeWidth="2dp"
    app:rippleColor="@color/michi_pink_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Foto del gatito: círculo con borde lavanda -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_michi"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CircleImage"
            app:strokeColor="@color/michi_lavender"
            app:strokeWidth="2dp" />

        <!-- Nombre del gatito -->
        <TextView
            android:id="@+id/tv_nombre_michi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Nombre"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/michi_on_surface"
            android:fontFamily="sans-serif-rounded" />

        <!-- Flecha indicadora (›) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="30sp"
            android:textColor="@color/michi_lavender_dark"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-rounded" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

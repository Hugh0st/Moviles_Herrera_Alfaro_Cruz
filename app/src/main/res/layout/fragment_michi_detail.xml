<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/michi_cream"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <!-- Foto grande circular con borde rosa -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_detail_michi"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="40dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CircleImage"
            app:strokeColor="@color/michi_pink"
            app:strokeWidth="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Nombre del gatito -->
        <TextView
            android:id="@+id/tv_detail_nombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="28dp"
            android:text="Nombre"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/michi_pink_dark"
            android:fontFamily="sans-serif-rounded"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/img_detail_michi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Card con la descripción -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_descripcion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginHorizontal="24dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/michi_lavender_container"
            app:strokeColor="@color/michi_lavender_light"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/tv_detail_nombre"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_detail_descripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="22dp"
                android:text="Descripción"
                android:textSize="16sp"
                android:textColor="@color/michi_on_surface"
                android:fontFamily="sans-serif-rounded"
                android:lineSpacingMultiplier="1.5"
                android:gravity="center" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Decoración inferior: chip pastel -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="50dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/michi_pink_container"
            app:strokeColor="@color/michi_pink_light"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/card_descripcion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  🐾 ¡Michi adoptado!  "
                android:textSize="13sp"
                android:textColor="@color/michi_pink_dark"
                android:fontFamily="sans-serif-rounded"
                android:paddingVertical="8dp" />

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>

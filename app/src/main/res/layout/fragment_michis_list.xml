<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/michi_cream">

    <!-- Encabezado con título y subtítulo -->
    <TextView
        android:id="@+id/tv_title_michis"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Mis Gatitos"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/michi_pink_dark"
        android:fontFamily="sans-serif-rounded"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="26dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_subtitle_michis"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Toca un gatito para conocerlo mejor"
        android:textSize="14sp"
        android:textColor="@color/michi_lavender_dark"
        android:fontFamily="sans-serif-rounded"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title_michis"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Línea divisoria suave -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/michi_outline_variant"
        android:layout_marginHorizontal="22dp"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle_michis"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Lista de gatitos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_michis"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
